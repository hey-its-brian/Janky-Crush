  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2"
  }
}
